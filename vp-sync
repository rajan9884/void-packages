#!/bin/sh
# vp-sync - one-command sync for void-packages + custom templates.
#
# Lives at the root of the void-packages checkout on the `custom` branch
# (committed, so it survives `git rebase origin/master`).
# Replaces the old per-package srcpkgs/<pkg>/update.sh helpers.
#
# Usage: vp-sync [--skip-sync] [--skip-bootstrap] [--skip-build]
#                [--skip-install] [--check-only] [pkg ...]
#
#   no args ......... sync official + bump/build/install all customs
#                     (installs the newest build of each custom that is
#                     already installed on this system; see step 5)
#   pkg args ........ restrict to named customs (e.g. vp-sync zen-browser);
#                     named pkgs are installed even if not yet installed
#   --skip-sync ..... don't fetch/rebase origin/master
#   --skip-bootstrap  don't refresh ./xbps-src binary-bootstrap
#   --skip-build .... bump templates only, no ./xbps-src pkg
#   --skip-install .. bump+build, no sudo xbps-install
#   --check-only .... print template-vs-upstream versions, change nothing
#
# Env: XBPS_DISTDIR (defaults to this checkout's directory).
#
# Workflow:
#   1. git fetch origin + rebase custom onto origin/master (official pkgs)
#   2. refresh binary-bootstrap if common/ changed
#   3. for each custom pkg: resolve latest upstream version (GitHub
#      releases/latest redirect or APT Packages index), compare with
#      template version=, patch version=/revision=/checksum= if outdated
#   3b. commit the bumped templates on the current branch (before the
#       build, so a later failure still leaves a clean working tree)
#   4. ./xbps-src pkg <outdated customs>  (output goes to
#      hostdir/binpkgs/<branch>[/nonfree] -- xbps-src names the build
#      repo after the git branch whenever it isn't master)
#   5. sudo xbps-install --repository=hostdir/binpkgs[/branch][/nonfree]
#      <pkgs>
#   5b. prune builds superseded in that repo (xbps-install itself never
#       deletes the .xbps it installed from)
#
#   Step 5 only touches customs already installed on this system, or
#   pkgs named explicitly on the command line -- a custom you never
#   installed is bumped+built but NOT installed behind your back.
#
# Official system packages are never touched; run `sudo xbps-install -Su`
# separately for those. Stay on the `custom` branch — no manual branch
# switching: step 1 rebases it onto origin/master automatically. Keep
# `master` pristine (never commit customs there).
#
# Adding a new custom package:
#   1. mkdir srcpkgs/<pkg>/ (+ template, update file, files/ as needed)
#   2. extend CUSTOM_PKGS above and add a resolve_pkg case
#      (github-release or APT-index pattern) + repo mapping in
#      install_repo_args if it is restricted/nonfree
#   3. git add srcpkgs/<pkg> && git commit (on `custom`)
#   4. vp-sync <pkg>   # explicit name => builds AND installs it

set -eu

CUSTOM_PKGS="zen-browser zed-editor helium-browser chatgpt-desktop claude-desktop wordcraft warp-cli"

SKIP_SYNC=0
SKIP_BOOTSTRAP=0
SKIP_BUILD=0
SKIP_INSTALL=0
CHECK_ONLY=0
PKGS=""
WANT="" # pkgs named explicitly on the command line (always installed)

for arg in "$@"; do
	case "$arg" in
		--skip-sync) SKIP_SYNC=1 ;;
		--skip-bootstrap) SKIP_BOOTSTRAP=1 ;;
		--skip-build) SKIP_BUILD=1 ;;
		--skip-install) SKIP_INSTALL=1 ;;
		--check-only) CHECK_ONLY=1 ;;
		-h|--help)
			sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
			echo "Custom packages: $CUSTOM_PKGS"
			exit 0
			;;
		-*) echo "Unknown option: $arg (see --help)" >&2; exit 1 ;;
		*)
			case " $CUSTOM_PKGS " in
				*" $arg "*) PKGS="$PKGS $arg"; WANT="$WANT $arg " ;;
				*) echo "Unknown package: $arg (one of:$CUSTOM_PKGS)" >&2; exit 1 ;;
			esac
			;;
	esac
done

[ -n "$PKGS" ] || PKGS=" $CUSTOM_PKGS "
# normalize to space-padded list for membership tests
PKGS=" $PKGS "

DISTDIR="${XBPS_DISTDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
export XBPS_DISTDIR="$DISTDIR"
# xbps-src puts built binpkgs in hostdir/binpkgs/<branch>[/nonfree] when
# the branch isn't master (XBPS_ALT_REPOSITORY defaults to the branch
# name); point the install step at the same place we build into.
REPO_BASE="$DISTDIR/hostdir/binpkgs"
_cur_branch=$(git -C "$DISTDIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo master)
if [ -n "$_cur_branch" ] && [ "$_cur_branch" != "master" ]; then
	REPO_BASE="$REPO_BASE/$_cur_branch"
fi
# restricted=yes templates (chatgpt/claude) need this; harmless for the rest.
export XBPS_ALLOW_RESTRICTED=yes
command -v curl >/dev/null || { echo "curl is required." >&2; exit 1; }

# --- 1. official upstream -----------------------------------------------
if [ "$SKIP_SYNC" -eq 0 ] && [ "$CHECK_ONLY" -eq 0 ]; then
	if ! git -C "$DISTDIR" diff --quiet || ! git -C "$DISTDIR" diff --cached --quiet; then
		echo "Working tree dirty in $DISTDIR; commit/stash first." >&2
		exit 1
	fi
	cur_branch=$(git -C "$DISTDIR" rev-parse --abbrev-ref HEAD)
	before=$(git -C "$DISTDIR" rev-parse HEAD)
	git -C "$DISTDIR" fetch origin master
	if [ "$cur_branch" = "custom" ]; then
		git -C "$DISTDIR" rebase "origin/master" || {
			echo "Rebase hit a conflict (likely upstream added a pkg with the" >&2
			echo "same name as a custom — resolve, then: git rebase --continue)." >&2
			exit 1
		}
	else
		echo "On branch '$cur_branch' (not custom); skipping rebase." >&2
	fi
	after=$(git -C "$DISTDIR" rev-parse HEAD)
	if [ "$SKIP_BOOTSTRAP" -eq 0 ]; then
		if [ "$before" != "$after" ] && git -C "$DISTDIR" diff --name-only "$before" "$after" -- common/ | grep -q .; then
			echo "common/ changed upstream; refreshing binary-bootstrap..."
			(cd "$DISTDIR" && ./xbps-src binary-bootstrap --update)
		fi
	fi
elif [ "$SKIP_BOOTSTRAP" -eq 0 ] && [ "$CHECK_ONLY" -eq 0 ]; then
	: # --skip-sync: leave bootstrap alone unless common/ handling requested
fi

# --- shared helpers -------------------------------------------------------
is_sha256() { # $1 -> 0 if it looks like a sha256 hex digest
	case "$1" in
		????????????????????????????????????????????????????????????????) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*[!0-9a-fA-F]*) return 1 ;;
	esac
	return 0
}

bump_version() { # $1=template $2=new_version
	sed -i 's/^version=[a-zA-Z0-9.+]\+/version='"$2"'/' "$1"
	sed -i 's/^revision=.*/revision=1/' "$1"
}

patch_checksums() { # $1=template $2=x86_sum $3=arm_sum
	if ! is_sha256 "$2"; then
		echo "Bad x86_64 checksum for $1." >&2
		return 1
	fi
	if ! is_sha256 "$3"; then
		echo "Bad aarch64 checksum for $1." >&2
		return 1
	fi
	tmpfile="$1.new.$$"
	awk -v x86="$2" -v arm="$3" '
		/^x86_64/ { branch = "x86" }
		/^aarch64/ { branch = "arm" }
		/^\*\)/ { branch = "" }
		{
			if ($0 ~ /^[ \t]+checksum=/ && branch != "")
				sub(/checksum=[0-9a-fA-F]+/,
				    "checksum=" (branch == "x86" ? x86 : arm))
			print
		}' "$1" > "$tmpfile"
	mv "$tmpfile" "$1"
}

# GitHub digest lookup: $1=api_url $2=x86_awk_pattern $3=arm_awk_pattern
# prints "x86_sum arm_sum"
github_sums() {
	if ! json=$(curl -fsSL "$1"); then
		echo "Failed to fetch $1" >&2
		return 1
	fi
	printf '%s\n' "$json" | awk -F'"' -v xpat="$2" -v apat="$3" '
		$2 == "name" && ($4 ~ xpat || $4 ~ apat) {
			if ($4 ~ xpat) pending_x = $4; else pending_a = $4
		}
		$2 == "digest" {
			d = $4; sub(/^sha256:/, "", d)
			if (pending_x != "") { xsum = d; pending_x = "" }
			else if (pending_a != "") { asum = d; pending_a = "" }
		}
		END { print xsum " " asum }'
}

latest_github_tag() { # $1=releases/latest url -> prints tag
	release_url=$(curl -fsSL -o /dev/null -w '%{url_effective}' "$1") || return 1
	basename "$release_url"
}

# APT index lookup: $1=base_url $2=pkg_prefix [3=dist, default "stable"]
# -> prints "ver x86_sum arm_sum"
apt_latest() {
	base="$1"; prefix="$2"; dist="${3:-stable}"
	if ! amd64=$(curl -fsSL "$base/dists/$dist/main/binary-amd64/Packages") ||
	   ! arm64=$(curl -fsSL "$base/dists/$dist/main/binary-arm64/Packages"); then
		echo "Failed to fetch APT index from $base (dist $dist)" >&2
		return 1
	fi
	latest_amd64=$(printf '%s\n' "$amd64" |
		awk -v p="$prefix" '/^Version:/ { ver = $2 } $0 ~ "^Filename: .*/"p"_" { file = $2 } /^SHA256:/ { if (ver != "" && file != "") print ver " " file " " $2 }' |
		sort -V | tail -n 1)
	latest_arm64=$(printf '%s\n' "$arm64" |
		awk -v p="$prefix" '/^Version:/ { ver = $2 } $0 ~ "^Filename: .*/"p"_" { file = $2 } /^SHA256:/ { if (ver != "" && file != "") print ver " " file " " $2 }' |
		sort -V | tail -n 1)
	ver=$(printf '%s\n' "$latest_amd64" | awk '{ print $1 }')
	ver_arm=$(printf '%s\n' "$latest_arm64" | awk '{ print $1 }')
	sum64=$(printf '%s\n' "$latest_amd64" | awk '{ print $3 }')
	sumarm=$(printf '%s\n' "$latest_arm64" | awk '{ print $3 }')
	if [ -z "$ver" ] || [ -z "$sum64" ] || [ -z "$sumarm" ]; then
		echo "No '$prefix' entry in $base/dists/$dist Packages index." >&2
		return 1
	fi
	if [ "$ver" != "$ver_arm" ]; then
		echo "Note: amd64 ($ver) and arm64 ($ver_arm) differ; using amd64." >&2
	fi
	printf '%s %s %s\n' "$ver" "$sum64" "$sumarm"
}

template_version() { # $1=template -> prints version=
	awk -F= '/^version=/ { print $2; exit }' "$1"
}

# Resolve latest version+checksums per package.
# Sets globals: LATEST_VER, SUM_X86, SUM_ARM.
resolve_pkg() { # $1=pkgname
	# reset: these are globals, and a failed lookup must not inherit the
	# previous package's values (that would bump a template to the wrong
	# version).
	LATEST_VER=""
	SUM_X86=""
	SUM_ARM=""
	case "$1" in
		zen-browser)
			tag=$(latest_github_tag "https://github.com/zen-browser/desktop/releases/latest")
			LATEST_VER=$(printf '%s' "$tag" | sed 's/-//g')
			api="https://api.github.com/repos/zen-browser/desktop/releases/tags/$tag"
			set -- $(github_sums "$api" '^zen\\.linux-x86_64\\.tar\\.xz$' '^zen\\.linux-aarch64\\.tar\\.xz$')
			SUM_X86=${1:-}; SUM_ARM=${2:-}
			;;
		zed-editor)
			tag=$(latest_github_tag "https://github.com/zed-industries/zed/releases/latest")
			LATEST_VER=$(printf '%s' "$tag" | sed 's/^v//')
			api="https://api.github.com/repos/zed-industries/zed/releases/tags/$tag"
			set -- $(github_sums "$api" '^zed-linux-x86_64\\.tar\\.gz$' '^zed-linux-aarch64\\.tar\\.gz$')
			SUM_X86=${1:-}; SUM_ARM=${2:-}
			;;
		helium-browser)
			tag=$(latest_github_tag "https://github.com/imputnet/helium-linux/releases/latest")
			LATEST_VER=$tag
			api="https://api.github.com/repos/imputnet/helium-linux/releases/tags/$tag"
			set -- $(github_sums "$api" 'x86_64_linux\\.tar\\.xz$' 'arm64_linux\\.tar\\.xz$')
			SUM_X86=${1:-}; SUM_ARM=${2:-}
			;;
		chatgpt-desktop)
			set -- $(apt_latest "https://persistent.oaistatic.com/codex-app-prod/linux/deb" "chatgpt")
			LATEST_VER=$1; SUM_X86=$2; SUM_ARM=$3
			;;
		claude-desktop)
			set -- $(apt_latest "https://downloads.claude.ai/claude-desktop/apt/stable" "claude-desktop")
			LATEST_VER=$1; SUM_X86=$2; SUM_ARM=$3
			;;
		wordcraft)
			tag=$(latest_github_tag "https://github.com/storytold/wordcraft/releases/latest")
			LATEST_VER=$(printf '%s' "$tag" | sed 's/^v//')
			api="https://api.github.com/repos/storytold/wordcraft/releases/tags/$tag"
			set -- $(github_sums "$api" '^wordcraft-.*-linux-x86_64\\.deb$' '^wordcraft-.*-linux-aarch64\\.deb$')
			SUM_X86=${1:-}; SUM_ARM=${2:-}
			;;
		warp-cli)
			# Same cloudflare-warp .deb the template downloads, but the
			# APT suite is "focal" (not "stable").
			set -- $(apt_latest "https://pkg.cloudflareclient.com" "cloudflare-warp" "focal")
			LATEST_VER=${1:-}; SUM_X86=${2:-}; SUM_ARM=${3:-}
			;;
	esac
	if [ -z "$LATEST_VER" ]; then
		echo "Failed to resolve version for $1." >&2
		return 1
	fi
	if ! is_sha256 "$SUM_X86" || ! is_sha256 "$SUM_ARM"; then
		echo "Failed to resolve checksums for $1 (got '$SUM_X86' / '$SUM_ARM')." >&2
		return 1
	fi
}

install_repo_args() { # $1=pkgname -> prints repo flag(s)
	# $REPO_BASE mirrors where xbps-src dropped the build (see top).
	case "$1" in
		chatgpt-desktop|claude-desktop) printf '%s' "--repository=$REPO_BASE/nonfree" ;;
		*) printf '%s' "--repository=$REPO_BASE" ;;
	esac
}

# --- 2+3. check/bump customs ----------------------------------------------
BUILT=""
installed_any=0
for pkg in $CUSTOM_PKGS; do
	case "$PKGS" in
		*" $pkg "*) ;;
		*) continue ;;
	esac
	tmpl="$DISTDIR/srcpkgs/$pkg/template"
	cur=$(template_version "$tmpl")
	resolve_pkg "$pkg"
	if [ "$CHECK_ONLY" -eq 1 ]; then
		if [ "$cur" = "$LATEST_VER" ]; then
			echo "$pkg: up to date ($cur)"
		else
			echo "$pkg: $cur -> $LATEST_VER"
		fi
		continue
	fi
	if [ "$cur" = "$LATEST_VER" ]; then
		echo "$pkg: up to date ($cur)"
		continue
	fi
	echo "$pkg: $cur -> $LATEST_VER"
	bump_version "$tmpl" "$LATEST_VER"
	patch_checksums "$tmpl" "$SUM_X86" "$SUM_ARM"
	echo "$pkg: template bumped (revision reset to 1)"
	BUILT="$BUILT $pkg"
done

if [ "$CHECK_ONLY" -eq 1 ]; then
	exit 0
fi

# Commit the bumps: step 1 refuses to run on a dirty tree, and bumping
# without committing made every *subsequent* run abort with
# "Working tree dirty ...; commit/stash first". Only the templates we
# just touched are staged. Done before the build so even a failed build
# leaves a clean tree.
if [ -n "$BUILT" ]; then
	bump_msg="custom: bump"
	for pkg in $BUILT; do
		git -C "$DISTDIR" add "srcpkgs/$pkg/template"
		bump_msg="$bump_msg $pkg $(template_version "$DISTDIR/srcpkgs/$pkg/template")"
	done
	if ! git -C "$DISTDIR" commit -q -m "$bump_msg"; then
		echo "Failed to commit bumped templates; commit/stash them before rerunning." >&2
		exit 1
	fi
	echo "Committed:$BUILT"
fi

# --- 4. build ----------------------------------------------------------------
if [ "$SKIP_BUILD" -eq 1 ]; then
	[ -n "$BUILT" ] && echo "Bump-only (--skip-build); outdated:$BUILT"
	exit 0
fi
if [ -z "$BUILT" ]; then
	echo "All custom templates current; nothing to build."
else
	for pkg in $BUILT; do
		(cd "$DISTDIR" && ./xbps-src pkg "$pkg") || {
			echo "Build failed for $pkg (its bump is already committed)." >&2
			echo "Fix srcpkgs/$pkg/template, then: ./xbps-src pkg $pkg" >&2
			exit 1
		}
		echo "Built $pkg"
	done
fi

# --- 5. install ---------------------------------------------------------------
# Install the newest binary sitting in the build repo for every custom that
# is installed on this system (or named explicitly). Deliberately NOT limited
# to $BUILT: a package that was built in an earlier run whose install failed
# (or a --skip-install run) still gets picked up here, and re-running
# vp-sync becomes idempotent.
if [ "$SKIP_INSTALL" -eq 1 ]; then
	exit 0
fi
for pkg in $CUSTOM_PKGS; do
	case "$PKGS" in
		*" $pkg "*) ;;
		*) continue ;;
	esac
	case " $WANT " in
		*" $pkg "*) want=1 ;;
		*) want=0 ;;
	esac
	inst_ver=$(xbps-query -p pkgver "$pkg" 2>/dev/null || true)
	if [ "$want" -eq 0 ] && [ -z "$inst_ver" ]; then
		continue
	fi
	# shellcheck disable=SC2086
	repo_ver=$(xbps-query $(install_repo_args "$pkg") -p pkgver "$pkg" 2>/dev/null || true)
	if [ -z "$repo_ver" ]; then
		echo "$pkg: nothing built in $(install_repo_args "$pkg"); skipping install"
		continue
	fi
	if [ "$repo_ver" = "$inst_ver" ]; then
		echo "$pkg: already at $inst_ver"
		continue
	fi
	# shellcheck disable=SC2086
	(cd "$DISTDIR" && sudo xbps-install $(install_repo_args "$pkg") -y "$pkg") || exit 1
	# xbps-install exits 0 even when it did nothing, so report what actually
	# ended up on disk.
	echo "Installed $(xbps-query -p pkgver "$pkg" 2>/dev/null || echo "$pkg (missing!)")"
	installed_any=1
done

# xbps-install never deletes the .xbps it installed from, so drop the
# versions that are now superseded in the build repo (keeps only the
# newest build of each custom). Note: this does not catch a *renamed*
# package (old pkgname stays indexed) -- remove that .xbps by hand and
# run `xbps-rindex -c <repodir>`.
if [ "${installed_any:-0}" -eq 1 ]; then
	for repo in "$REPO_BASE" "$REPO_BASE/nonfree"; do
		[ -d "$repo" ] || continue
		xbps-rindex -r "$repo" || echo "warning: could not prune $repo" >&2
	done
fi
