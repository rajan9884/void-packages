# Template file for 'chatgpt-desktop'
# Binary repack of official upstream OpenAI .deb packages, same pattern as
# srcpkgs/google-chrome and srcpkgs/vivaldi (upstream ships a .deb, xbps-src
# extracts it, files are installed verbatim from usr/).
# Upstream publishes amd64/arm64 .debs in its own APT repository
# (https://persistent.oaistatic.com/codex-app-prod/linux/deb); checksums below
# are the SHA256 lines from the binary-amd64 / binary-arm64 Packages indexes.
pkgname=chatgpt-desktop
version=26.1007.21434
revision=1
archs="x86_64 aarch64"
depends="alsa-lib at-spi2-core cups desktop-file-utils glib gtk+3 gvfs hicolor-icon-theme
 libXtst libdrm libnotify libsecret libuuid libxcb libxkbcommon mesa nss xdg-desktop-portal
 xdg-utils"
short_desc="Desktop application for ChatGPT"
maintainer="Rajan Jaiswal <rajan.dev.jaiswal@gmail.com>"
license="custom:Proprietary"
homepage="https://developers.openai.com/codex/app"
changelog="https://learn.chatgpt.com/docs/linux/linux-app"
repository=nonfree
restricted=yes
nostrip=yes
# Bundled Qt shims would pull bogus shlib deps; ignore them for
# dependency resolution (same as google-chrome/vivaldi do).
skiprdeps="/usr/lib/chatgpt/libqt5_shim.so /usr/lib/chatgpt/libqt6_shim.so"
# NOTE: unlike claude-desktop/spotify, no create_wrksrc here: this .deb's
# data.tar contains two top-level dirs (etc/ + usr/), so do-extract keeps
# them inside $wrksrc and `vcopy usr /` below works as-is.
case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/chatgpt_${version}_amd64.deb"
	checksum=276b5341c3d74b261d3ad52106f7fa7edde06841e4767fe2a40cb54099b1f3ed
	;;
aarch64*)
	distfiles="https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/chatgpt_${version}_arm64.deb"
	checksum=55fae1e3fb1d6069a90620e9e70737dcf8bf2255604d157e282cc6748a1baf49
	;;
*)
	broken="No upstream .deb for $XBPS_TARGET_MACHINE (only amd64/arm64 are provided)"
	;;
esac

post_extract() {
	# Debian-only residue must not ship: AppArmor profile is
	# Ubuntu/Debian specific, and the apt repo entry + keyring handling
	# from postinst is intentionally not reproduced (updates come from
	# rebuilding this template, same as claude-desktop).
	rm -rf etc

	# Drop bundled prebuilds for foreign OSes/libcs (Android, Windows,
	# macOS, musl): the Android ones link liblog.so and the musl ones
	# link libc.musl, neither of which maps to a Void package, so shlib
	# guessing aborts on them. They can never load on a glibc Linux
	# desktop anyway (upstream only targets glibc distros).
	find usr/lib/chatgpt \( -name '*musl*' -o -type d \( -name 'android-*' \
		-o -name 'win32-*' -o -name 'darwin-*' \) \) -exec rm -rf {} +
}

do_install() {
	# The .deb extracts to usr/bin/chatgpt (symlink to
	# ../lib/chatgpt/codex-launcher, a shell wrapper exec'ing ChatGPT),
	# usr/lib/chatgpt/ (Electron app), plus desktop file, icons and docs
	# under usr/share.
	vcopy usr /
}

post_install() {
	vlicense usr/share/doc/chatgpt/copyright
}
