# Template file for 'cloudflare-warp'
# Binary repack of official upstream Cloudflare WARP .deb packages
# Upstream publishes amd64/arm64 .debs in its own APT repository
# (https://pkg.cloudflareclient.com/); checksums below
# are the SHA256 lines from the binary-amd64 / binary-arm64 Packages indexes.
pkgname=cloudflare-warp
version=0.0.0
revision=1
archs="x86_64 aarch64"
depends="dbus-libs glibc iproute2 nftables gnupg desktop-file-utils libcap-progs nss ca-certificates libpcap"
short_desc="Cloudflare Warp Client"
maintainer="Rajan Jaiswal <rajan.dev.jaiswal@gmail.com>"
license="unknown"
homepage="https://1.1.1.1"
changelog="https://pkg.cloudflareclient.com/"
# repository=nonfree
# restricted=yes
nostrip=yes
# The .deb's data.tar contains only a single top-level dir (usr/). Without
# this, do-extract would rename that lone usr/ to $wrksrc and `vcopy usr /`
# below would fail (same reason srcpkgs/spotify sets it).
create_wrksrc=yes
case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="https://pkg.cloudflareclient.com/pool/focal/main/c/cloudflare-warp/cloudflare-warp_${version}_amd64.deb"
	checksum=339405a6601e0a30f7e82155b0fff5f1cdd9dfefb2f23a2f01494bc39d489aee
	;;
aarch64*)
	distfiles="https://pkg.cloudflareclient.com/pool/focal/main/c/cloudflare-warp/cloudflare-warp_${version}_arm64.deb"
	checksum=54cc0e21daf30486afb26809e5b83d86f06761fae754370a279e2fed31c08cef
	;;
*)
	broken="No upstream .deb for $XBPS_TARGET_MACHINE (only amd64/arm64 are provided)"
	;;
esac

do_install() {
	# The .deb extracts to usr/bin/warp-svc (daemon), usr/bin/warp-cli (CLI),
	# usr/lib/cloudflare-warp/ (resources), plus desktop file, icons and docs under usr/share.
	vcopy usr /

	# Ensure the warp-svc executable is present and has appropriate permissions?
	# The Debian package likely sets them correctly.
}

post_install() {
	vlicense usr/share/doc/cloudflare-warp/copyright
}
