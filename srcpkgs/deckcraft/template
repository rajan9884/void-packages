# Template file for 'deckcraft'
# Binary repack of official upstream storytold .deb packages, same pattern as
# ../wordcraft and ../claude-desktop (itself modeled on srcpkgs/google-chrome
# and srcpkgs/vivaldi: upstream ships a .deb, xbps-src extracts it, files are
# installed verbatim from usr/).
# Upstream publishes x86_64/aarch64 .debs on GitHub releases
# (https://github.com/storytold/deckcraft/releases); checksums below
# are the sha256: digests from the GitHub release API.
pkgname=deckcraft
version=0.14.1
revision=1
archs="x86_64 aarch64"
depends="desktop-file-utils hicolor-icon-theme libxkbcommon vulkan-loader alsa-lib"
short_desc="Open-source native presentation app, PowerPoint alternative"
maintainer="Rajan Jaiswal <rajan.dev.jaiswal@gmail.com>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps/deckcraft"
changelog="https://github.com/storytold/deckcraft/releases"
nostrip=yes
# The .deb's data.tar contains only a single top-level dir (usr/). Without
# this, do-extract would rename that lone usr/ to $wrksrc and `vcopy usr /`
# below would fail (same reason srcpkgs/spotify sets it).
create_wrksrc=yes
case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="https://github.com/storytold/deckcraft/releases/download/v${version}/deckcraft-${version}-linux-x86_64.deb"
	checksum=d17ffd935f8ae3c8e9790648a00d4d019f11b52bf5db207ec6e4d466a108ec2f
	;;
aarch64*)
	distfiles="https://github.com/storytold/deckcraft/releases/download/v${version}/deckcraft-${version}-linux-aarch64.deb"
	checksum=bb90fc843c852109abd48e42750fcfd52197d91ea6469d8f3d768b6a3b28eff6
	;;
*)
	broken="No upstream .deb for $XBPS_TARGET_MACHINE (only x86_64/aarch64 are provided)"
	;;
esac

do_install() {
	# The .deb extracts to usr/bin/deckcraft + usr/bin/deckcraft-cli,
	# plus desktop file, icons, MIME info and docs under usr/share.
	vcopy usr /
}

post_install() {
	vlicense usr/share/doc/deckcraft/LICENSE-MIT
	vlicense usr/share/doc/deckcraft/LICENSE-APACHE
}
