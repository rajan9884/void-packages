# Template file for 'helium-browser'
# Binary repack of official upstream Helium tarballs, same pattern as
# ../zen-browser and ../zed-editor (themselves modeled on srcpkgs/vivaldi,
# srcpkgs/google-chrome, srcpkgs/discord: upstream ships binaries, install
# to /opt, symlink /usr/bin).
# Runtime deps mapped from Arch helium-browser-bin
# (alsa-lib dbus gtk3 hicolor-icon-theme libcups libpulse libva libxss
#  nss ttf-liberation udev xdg-utils); the rest is pulled in via shlibs.
pkgname=helium-browser
version=0.18.3.1
revision=1
archs="x86_64 aarch64"
depends="alsa-lib dbus desktop-file-utils gtk+3 hicolor-icon-theme libcups
 libXScrnSaver libnotify libpulseaudio libva nss nspr eudev-libudev xdg-utils"
short_desc="Private, fast, and honest Chromium-based web browser"
maintainer="Rajan Jaiswal <rajan.dev.jaiswal@gmail.com>"
license="GPL-3.0-only, BSD-3-Clause"
homepage="https://helium.computer"
changelog="https://github.com/imputnet/helium-linux/releases"
case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-x86_64_linux.tar.xz"
	checksum=89bd962ca5e5159916a4c4befa5a9a08f540d2d8cd794f2f955e8d5d4a463bf2
	;;
aarch64*)
	distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-arm64_linux.tar.xz"
	checksum=4b7b744e55c40272fb34b148aead7e36b8d8d08d044131f4572f4fa95d14ec92
	;;
*)
	broken="No upstream tarball for $XBPS_TARGET_MACHINE (only x86_64/arm64 are provided)"
	;;
esac
skiprdeps="/opt/helium-browser/libqt5_shim.so /opt/helium-browser/libqt6_shim.so"
nostrip=yes

post_extract() {
	# Tag this build as a Void package for bug reports, same idea as the
	# Arch ("Arch Linux") and deb ("deb") / rpm ("rpm") wrappers.
	sed -i 's/^export CHROME_VERSION_EXTRA=.*/export CHROME_VERSION_EXTRA="Void Linux"/' \
		helium-wrapper
}

do_install() {
	# Upstream tarball extracts to a single top-level
	# "helium-${version}-<arch>_linux/" dir, which xbps-src renames to
	# $wrksrc, so browser files are in $wrksrc root:
	#   helium helium-wrapper helium.desktop product_logo_256.png
	#   *.pak *.so* locales/ resources/ ...
	vmkdir opt/helium-browser
	vcopy "*" opt/helium-browser

	vmkdir usr/bin
	ln -sf /opt/helium-browser/helium-wrapper ${DESTDIR}/usr/bin/helium-browser

	vinstall ${FILESDIR}/helium.desktop 644 usr/share/applications

	vinstall product_logo_256.png 644 \
		usr/share/icons/hicolor/256x256/apps helium-browser.png
}
